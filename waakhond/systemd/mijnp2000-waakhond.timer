[Unit]
Description=Elke vijf minuten controleren of MijnP2000 nog meldingen verwerkt

[Timer]
OnCalendar=*:00/5
AccuracySec=30s
# Een korte spreiding, zodat de controle niet elke ronde op precies hetzelfde
# moment samenvalt met andere timers op de server. Kort houden, want de ronde
# loopt nu elke vijf minuten.
RandomizedDelaySec=20
Persistent=false

[Install]
WantedBy=timers.target
