# Instellingen van de waakhond van MijnP2000.
# Kopieer dit bestand naar /etc/mijnp2000/waakhond.env en vul het in.
# Dit bestand bevat wachtwoorden en hoort niet in de repository.

# ── De hartslag van de ontvanger ─────────────────────────────────────────
# De ontvanger op de sdr-server zet elke minuut een bewaard bericht op dit
# onderwerp. Daar leest de waakhond aan af of de verwerking nog loopt.
MQTT_HOST=192.168.2.38
MQTT_PORT=1883
MQTT_USER=p2000
MQTT_PASSWORD=
STATUS_TOPIC=p2000/status
# Hoelang wachten op het bewaarde bericht voordat de waakhond opgeeft.
HARTSLAG_WACHT_SECONDEN=15

# ── De bedieningsdienst op de sdr-server ─────────────────────────────────
# Rechtstreeks op poort 8330, dus niet via mijnsdr.lab023.nl; die weg gaat
# langs de centrale aanmelding. De sleutel is dezelfde BEDIEN_SLEUTEL als in
# /opt/mijnsdr-bediening/.env op de sdr-server.
BEDIENING_URL=http://sdrserver:8330
BEDIEN_SLEUTEL=
BEDIEN_EXPERIMENT=p2000

# ── Drempels en remmen ───────────────────────────────────────────────────
# Stilte waarna er iets moet gebeuren. Ruimer dan de tijd tussen twee
# controles, anders wordt er herstart terwijl de ontvanger nog opstart.
STIL_DREMPEL_MINUTEN=30
# Rust na een herstart, zodat de ontvanger op gang kan komen.
HERSTART_WACHT_MINUTEN=5
# Hoogstens dit aantal herstarts binnen het venster; daarna alleen melden.
HERSTART_MAX=3
HERSTART_VENSTER_UUR=6
# Blijft hetzelfde probleem bestaan, dan hoogstens eens per zoveel uur melden.
MELDING_WACHT_UUR=6
# Proefstand: 1 betekent wel melden, maar niet herstarten.
ALLEEN_MELDEN=0
# Waar de stand tussen twee controles wordt bewaard.
STATUS_BESTAND=/var/lib/mijnp2000-waakhond/status.json

# ── Kanaal 1: mail ───────────────────────────────────────────────────────
# Staat aan zodra ALERT_NAAR en SMTP_HOST allebei gevuld zijn.
# Meerdere adressen met een komma ertussen.
ALERT_NAAR=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_VAN=
MAIL_NAAM=MijnP2000

# ── Kanaal 2: MQTT naar Home Assistant ───────────────────────────────────
# Staat aan zodra MQTT_HOST en MELD_TOPIC allebei gevuld zijn. Home Assistant
# luistert op dit onderwerp en maakt er een telefoonmelding van.
MELD_TOPIC=p2000/waakhond
MELD_CLIENT_ID=mijnp2000-waakhond
