# Kopieer dit bestand naar .env en vul het wachtwoord in.
# .env blijft buiten de repository (zie .gitignore).
MQTT_PASSWORD=vul-hier-het-broker-wachtwoord-in

# Kaartpagina (/kaart). Blijft KAART_POSTCODE en KAART_LAT/KAART_LON leeg, dan
# blijft de lijstpagina gewoon werken en meldt de kaartpagina dat het middelpunt
# ontbreekt. De postcode wordt een keer opgezocht bij de PDOK Locatieserver en
# daarna uit de eigen database gehaald.
KAART_POSTCODE=2011 AB
# Rechtstreekse coordinaten gaan voor op de postcode; laat ze leeg als de
# postcode genoeg is.
KAART_LAT=
KAART_LON=
# Straal van het gebied in kilometers en het venster in minuten. Dit zijn de
# standaardwaarden van de pagina; op de pagina zelf is de straal bij te stellen.
KAART_STRAAL_KM=12
KAART_MINUTEN=60
# Sleutel voor de basiskaart van CARTO, dezelfde als bij mijnradar en mijnais.
# Blijft de sleutel leeg, dan werkt de kaart gewoon, maar ligt er een watermerk
# over de tegels.
CARTO_KEY=
